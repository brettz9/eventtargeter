{
  "name": "eventtargeter",
  "version": "0.11.0",
  "description": "W3C JavaScript events for custom objects",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index-es.js",
  "type": "module",
  "types": "./dist/EventTarget.d.ts",
  "browserslist": [
    "defaults, not op_mini all"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/EventTarget.d.ts",
        "default": "./dist/index-es.js"
      },
      "require": {
        "types": "./dist/EventTarget.d.cts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "prepublishOnly": "npm run build && npm run tsc && npm run attw",
    "attw": "attw --pack . --profile node16",
    "tsc": "tsc",
    "start": "static -p 8090",
    "lint": "npm run eslint",
    "eslint": "eslint .",
    "rollup": "rollup -c",
    "postrollup": "node -e \"require('node:fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type: 'commonjs'}, null, 2) + '\\n')\"",
    "build": "npm run rollup && tsc -p tsconfig-prod.json",
    "coverage": "open-cli http://localhost:8090/coverage/ && npm start",
    "mocha": "rm -Rf node_modules/.cache && c8 mocha --require chai/register-expect.js",
    "test": "npm run eslint && npm run build && npm run mocha",
    "browser-test": "npm run eslint && npm run build && open-cli http://localhost:8090/test/ && npm start"
  },
  "c8": {
    "reporter": [
      "html",
      "text"
    ],
    "exclude": [
      "dist",
      "test"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/brettz9/eventdispatcher.js.git"
  },
  "keywords": [
    "EventTarget",
    "events",
    "W3C"
  ],
  "author": "Brett Zamir",
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/brettz9/eventdispatcher.js/issues"
  },
  "homepage": "https://github.com/brettz9/eventdispatcher.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@node-static/node-static": "0.9.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "chai": "6.2.2",
    "eslint": "^10.9.1",
    "eslint-config-ash-nazg": "^42.6.0",
    "mocha": "11.8.0",
    "open-cli": "^9.0.0",
    "rollup": "4.62.5",
    "typescript": "^7.0.2"
  }
}
